          "name": "Connect two numbers or connect a number to a call flow",
          "request": {
            "name": "Connect two numbers or connect a number to a call flow",
            "description": {
              "content": "Places an outbound call. In the \"connect two numbers\" mode, Exotel first calls `From`, and when answered connects to `To`. In the \"connect to a flow\" mode, provide `Url` pointing to an Exotel call flow (App/applet, e.g. `http://my.exotel.com/{sid}/exoml/start_voice/{flow_id}`) instead of `To`. Confirmed endpoint; body schema modeled from documented form parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "Accounts",
                ":sid",
                "Calls",
                "connect.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
